{#
SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
SPDX-License-Identifier: Apache-2.0

Cocogitto changelog template of the change list in release notes (see .github/release/release-notes.sh).
Groups commits by type, omits the `chore(version)` release commits, and keeps entries short: GitHub
links the short commit ids and @usernames (see [[changelog.authors]] in .cog.toml) by itself.
-#}
{% for value in commits | group_by_type -%}
{% set_global entries = [] -%}
{% for commit in value.1 -%}
{% if commit.scope == "version" and commit.summary is starting_with("v") -%}
{% else -%}
{% set_global entries = entries | concat(with=commit) -%}
{% endif -%}
{% endfor -%}
{% if entries | length > 0 %}
#### {{ value.0 | upper_first }}
{% for commit in entries -%}
{% if commit.author %}{% set author = "@" ~ commit.author %}{% else %}{% set author = commit.signature %}{% endif -%}
- {% if commit.breaking_change %}**BREAKING** {% endif %}{% if commit.scope %}(**{{ commit.scope }}**) {% endif %}{{ commit.summary }} ({{ commit.id | truncate(length=7, end="") }}) - {{ author }}
{#- co-authors (commit footers are available since cog 7) -#}
{%- if commit.footers -%}
{%- for footer in commit.footers -%}
{%- if footer.github_co_authored_by -%}
{%- if footer.github_co_authored_by.username %}, @{{ footer.github_co_authored_by.username }}{% else %}, {{ footer.github_co_authored_by.user }}{% endif -%}
{%- endif -%}
{%- endfor -%}
{%- endif %}
{% endfor -%}
{% endif -%}
{% endfor -%}
