load("@rules_python//python:defs.bzl", "py_library")
load("@rules_python//python:packaging.bzl", "py_package", "py_wheel")

# Proxy library to include PEP 561 type-marker
py_library(
    name = "pylib",
    data = ["py.typed"],
    visibility = ["//visibility:public"],
    deps = [
        "@ncore_repo//ncore/data:pylib",
        "@ncore_repo//ncore/data/stores:pylib",
        "@ncore_repo//ncore/data/v4:pylib",
        "@ncore_repo//ncore/data_converter:pylib",
        "@ncore_repo//ncore/geometry:pylib",
        "@ncore_repo//ncore/sensors:pylib",
    ],
)

# Collect all dependencies within the ncore.* subpackages to export in wheel
py_package(
    name = "ncore_pkg",
    packages = ["ncore"],
    deps = [
        "@ncore_repo//ncore:pylib",
    ],
)

# Export packages by creating wheel
py_wheel(
    name = "ncore_wheel",
    abi = "none",
    author = "NVIDIA Corporation",
    description_file = "PYPI_README.md",
    distribution = "nvidia-ncore",
    homepage = "https://github.com/NVIDIA/ncore",
    license = "Apache-2.0",
    platform = "any",
    python_requires = ">=3.8",
    python_tag = "py3",
    requires = [
        "numpy",
        # dataclasses_json version restriction rationale: deserialization fails with earlier versions
        "dataclasses_json>=0.2.12",
        # pillow version rationale:
        # - 12.2.0 fixes CVE-2026-42311 (out-of-bounds write in decode.c/encode.c), requires python>=3.10
        "pillow>=12.2.0; python_version>='3.10'",
        "pillow; python_version<'3.10'",
        # zarr version restrictions / suggestions rationale:
        # - both zarr-python 2 and zarr-python 3 are supported, zarr-python 3 requires python>=3.11
        # - 2.18.7 is the first zarr-python 2 version with the correct numcodecs<0.16 restriction (requires python>=3.11)
        # - 3.1.4 is the oldest supported zarr-python 3 version (Array.async_array, Store ABC without set_partial_values)
        # - 2.12.0 is the last version supporting python3.8 with old numpy versions, which we still want to support for now
        "zarr>=2.18.7,!=3.0.*,!=3.1.0,!=3.1.1,!=3.1.2,!=3.1.3; python_version>='3.11'",
        "zarr>=2.12.0,<3; python_version<'3.11'",
        # imported directly (zarr compressors / codecs, and asynchronous filesystems of remote archives)
        "numcodecs",
        "fsspec",
        # cbor2 version rationale:
        # - 5.9.0 fixes CWE-674 / CVE-2026-26209 (uncontrolled recursion DoS), requires python>=3.9
        "cbor2>=5.9.0; python_version>='3.9'",
        "cbor2; python_version<'3.9'",
        "scipy",
        "torch",
        "typing_extensions",
        "universal_pathlib",
    ],
    summary = "A unified data format and library for AV / robotics",
    # Build / deploy wheels:
    # - bazel build //ncore:ncore_wheel.dist --stamp --embed_label=<VERSION>
    # - bazel run //ncore:ncore_wheel.publish --stamp --embed_label=<VERSION> -- --repository pypi --verbose --skip-existing --non-interactive
    #
    # Version is set via --embed_label and requires calling targets with `--stamp`, default is set in .bazelrc
    version = "{BUILD_EMBED_LABEL}",
    deps = [
        ":ncore_pkg",
    ],
)
